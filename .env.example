# PostgreSQL connection used by the application
DATABASE_URL=postgresql://tourguard:tourguard@localhost:5436/tourguard_dev

# Required operator credential for protected guide and tour endpoints
OPERATOR_API_KEY=replace-with-a-long-random-value

# Public base URL used when generating tourist assistant links
TOURIST_ASSISTANT_BASE_URL=http://localhost:5173

# Africa's Talking SMS credentials
AT_USERNAME=sandbox
AT_API_KEY=replace-with-africas-talking-api-key
AT_SENDER_ID=TourGuard
AT_SHORTCODE=

# NestJS HTTP port
PORT=3004

# Local Ollama server and model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=30000

# Public endpoint rate limit
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000
